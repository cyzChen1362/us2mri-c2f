  "validation": {
    "primary": "case_macro_center_error_mm",
    "secondary": "case_macro_box_iou",
    "all_saved_planes": true
  },
  "resources": {
    "gpus": 1,
    "cpus": 4,
    "memory": "48G",
    "time": "24:00:00"
  },
  "output_root": "${DATA_ROOT}/Cross-Modality_USConditioned_GridLocator_FLAIR_v1"
