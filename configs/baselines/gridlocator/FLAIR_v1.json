{
  "name": "Cross-Modality_USConditioned_GridLocator_FLAIR_v1",
  "modality": "FLAIR",
  "seed": 42,
  "data": {
    "dataset_variant": "MRIFullVision",
    "dataset_root": "${DATA_ROOT}/coregistered_MRIFullVision",
    "cache_root": "${DATA_ROOT}/FLAIR",
    "split_file": "${DATA_ROOT}/flair_split_used.json",
    "branch": "us-space-flair-all-remind-20261022"
  },
  "spacing": {
    "us_mm": 0.5,
    "mri_mm": 1.0
  },
  "model": {
    "stride": 4,
    "mri_channels": [
      19,
      32,
      64,
      128
    ],
    "mri_feature_channels": 64,
    "us_vector_channels": 64,
    "us_pool": [
      5,
      4
    ]
  },
  "labels": {
    "sigma_mm": 5.8,
    "regression_radius_mm": 4.9,
    "slab_thickness_mm": 1.0,
    "size_scale_mm": 98.9,
    "window": "unpadded_saved_US_bbox_rectangle",
    "grid_center_xyz": "4 * index_xyz + 1.5"
