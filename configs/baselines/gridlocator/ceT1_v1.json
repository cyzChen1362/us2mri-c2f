{
  "name": "Cross-Modality_USConditioned_GridLocator_ceT1_v1",
  "modality": "ceT1",
  "seed": 42,
  "data": {
    "dataset_variant": "MRIFullVision",
    "dataset_root": "${DATA_ROOT}/coregistered_MRIFullVision",
    "cache_root": "${DATA_ROOT}/ceT1",
    "split_file": "${DATA_ROOT}/cet1_subject_split.json",
    "branch": "us-space"
  },
  "spacing": {
    "us_mm": 0.5,
    "mri_mm": 1.0
  },
  "model": {
    "stride": 4,
    "mri_channels": [
      15,
      32,
      64,
      128
    ],
    "mri_feature_channels": 64,
    "us_vector_channels": 64,
    "us_pool": [
      5,
      5
    ]
  },
  "labels": {
    "sigma_mm": 2.7,
    "regression_radius_mm": 8.2,
    "slab_thickness_mm": 1.0,
    "size_scale_mm": 98.4,
    "window": "unpadded_saved_US_bbox_rectangle",
    "grid_center_xyz": "4 * index_xyz + 1.5"
  },
  "loss": {
    "center": "normalized_gaussian_spatial_cross_entropy",
    "offset": "smooth_l1",
    "size": "smooth_l1_positive",
    "offset_weight": 1.0,
    "size_weight": 1.0
  },
  "training": {
    "max_epochs": 200,
    "early_stopping": false,
    "max_US_per_update": 32,
    "fusion_microbatch": 32,
    "slice_stride": 4,
    "offset": "(epoch-1)%4",
    "learning_rate": 0.00014,
    "weight_decay": 0.00013,
    "optimizer": "AdamW",
    "scheduler": "constant",
    "precision": "bfloat16",
    "gradient_clip": 11.0,
    "checkpoint_seconds": 48
  },
  "validation": {
    "primary": "case_macro_center_error_mm",
    "secondary": "case_macro_box_iou",
    "all_saved_planes": true
  },
  "resources": {
    "gpus": 1,
    "cpus": 5,
    "memory": "48G",
    "time": "24:00:00"
  },
  "output_root": "${DATA_ROOT}/Cross-Modality_USConditioned_GridLocator_ceT1_v1"
}
