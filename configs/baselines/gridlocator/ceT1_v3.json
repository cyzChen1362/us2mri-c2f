{
  "name": "Cross-Modality_USConditioned_GridLocator_ceT1_v3",
  "modality": "ceT1",
  "seed": 42,
  "data": {
    "dataset_variant": "MRIFullVision",
    "dataset_root": "${DATA_ROOT}/coregistered_MRIFullVision",
    "cache_root": "${DATA_ROOT}/ceT1",
    "split_file": "${DATA_ROOT}/cet1_subject_split.json",
    "branch": "us-space"
  },
  "spacing": {
    "us_mm": 0.5,
    "mri_mm": 1.0
  },
  "model": {
    "stride": 5,
    "mri_channels": [
      17,
      32,
      64,
      128
    ],
    "mri_feature_channels": 64,
    "architecture": "spatial_template_v3",
    "correlation_channels": 13,
    "orientations": 32,
    "orientation_bank": "${DATA_ROOT}/orientation_bank.json",
    "correlation_method": "fft",
    "checkpoint_correlation": true,
    "us_stride": 9,
    "us_canvas_odd_blocks": true,
    "dropout3d": 0.0
  },
  "labels": {
    "slab_thickness_mm": 1.0,
    "size_scale_mm": 98.4,
    "window": "unpadded_saved_US_bbox_rectangle",
    "grid_center_xyz": "4 * index_xyz + 1.5",
    "assignment": "seven_equal_hard"
  },
  "loss": {
    "center": "seven_equal_hard_cross_entropy",
    "offset": "smooth_l1",
    "size": "smooth_l1_positive",
    "offset_weight": 3.1,
    "size_weight": 1.0
  },
  "training": {
    "max_epochs": 200,
    "early_stopping": false,
    "max_US_per_update": 7,
    "fusion_microbatch": 8,
    "slice_stride": 3,
    "offset": "(epoch-1)%4",
    "learning_rate": 6.6e-05,
    "weight_decay": 0.00013,
    "optimizer": "AdamW",
    "scheduler": "constant",
    "precision": "bfloat16",
    "gradient_clip": 9.6,
    "checkpoint_seconds": 48
  },
  "validation": {
    "primary": "case_macro_center_error_mm",
    "secondary": "case_macro_box_iou",
    "all_saved_planes": true
  },
  "resources": {
    "gpus": 1,
    "cpus": 4,
    "memory": "48G",
    "time": "24:00:00"
  },
  "output_root": "${DATA_ROOT}/Cross-Modality_USConditioned_GridLocator_ceT1_v3",
  "augmentation": {
    "fov_scale": 1.1,
    "translation_fraction": 0.15,
    "rotation_degrees": 17.0,
    "label_margin_mm": 2.8,
    "seed_mode": "seed_epoch_group",
    "resample": "native_mri_once_per_group",
    "validation": "original_v2_roi"
  }
}
